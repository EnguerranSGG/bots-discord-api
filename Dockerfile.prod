# =============================================================================
# STAGE 1: Build stage
# =============================================================================
FROM node:22-alpine AS builder

# Définir le répertoire de travail
WORKDIR /app

# Copier les fichiers de dépendances
COPY package*.json ./

# Installer TOUTES les dépendances (dev + prod) pour le build
RUN npm ci --only=production=false

# Copier le code source
COPY . .

# Compiler TypeScript vers JavaScript
RUN npm run build

# =============================================================================
# STAGE 2: Production stage
# =============================================================================
FROM node:22-alpine AS production

# Métadonnées de l'image
LABEL maintainer="enguerran.smaagghe@hotmail.fr"
LABEL description="Bot Discord API Production Image"
LABEL version="1.0.0"

# Installer dumb-init, wget et logrotate
RUN apk add --no-cache dumb-init wget logrotate

# Créer l'utilisateur non-root pour la sécurité
RUN addgroup -S -g 1001 app-user && \
    adduser -S -u 1001 -G app-user app-user

# Définir le répertoire de travail
WORKDIR /app

# Copier les fichiers de dépendances
COPY package*.json ./

# Installer UNIQUEMENT les dépendances de production
RUN npm ci --only=production --no-audit --no-fund && \
    npm cache clean --force

# Copier les fichiers compilés depuis le stage de build
COPY --from=builder --chown=app-user:app-user /app/dist ./dist

# Copier la configuration logrotate
COPY --chown=root:root scripts/logrotate/api-logs /etc/logrotate.d/api-logs

# Créer les dossiers nécessaires et donner les permissions
RUN mkdir -p /app/logs /app/uploads && \
    chown -R app-user:app-user /app && \
    chmod 644 /etc/logrotate.d/api-logs

# Créer le script de démarrage
RUN echo '#!/bin/sh\n\
echo "Waiting for database..."\n\
while ! pg_isready -h db -p 5432 -U postgres; do\n\
  sleep 1\n\
done\n\
echo "Running database seed..."\n\
node dist/src/database/seed.js\n\
echo "Starting API..."\n\
node dist/src/main.js\n\
' > /app/start.sh && \
chmod +x /app/start.sh

# Changer vers l'utilisateur non-root
USER app-user

# Variables d'environnement de production
ENV NODE_ENV=production
ENV NPM_CONFIG_LOGLEVEL=warn
ENV PORT=3000

# Exposer le port de l'API
EXPOSE 3000

# Health check pour monitoring
HEALTHCHECK --interval=30s --timeout=10s --start-period=60s --retries=3 \
    CMD wget --no-verbose --tries=1 --spider http://localhost:3000/health || exit 1

# Point d'entrée avec dumb-init pour une gestion propre des signaux
ENTRYPOINT ["dumb-init", "--"]

# Commande par défaut - utiliser le script de démarrage
CMD ["/app/start.sh"]